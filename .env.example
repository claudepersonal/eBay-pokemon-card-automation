# Copy to .env and fill in. All variables are prefixed with CARDLISTER_.
# .env is gitignored — never commit real credentials.

# Which eBay environment to talk to: "sandbox" or "production".
CARDLISTER_EBAY_ENV=sandbox

# eBay developer keyset (https://developer.ebay.com/my/keys) — one set per environment.
# RU name is the redirect "RuName" you create under your application's user tokens.
CARDLISTER_EBAY_SANDBOX_APP_ID=
CARDLISTER_EBAY_SANDBOX_CERT_ID=
CARDLISTER_EBAY_SANDBOX_RU_NAME=

CARDLISTER_EBAY_PRODUCTION_APP_ID=
CARDLISTER_EBAY_PRODUCTION_CERT_ID=
CARDLISTER_EBAY_PRODUCTION_RU_NAME=

# Default listing parameters (US marketplace, ungraded Pokémon singles).
CARDLISTER_EBAY_MARKETPLACE_ID=EBAY_US
CARDLISTER_EBAY_CATEGORY_ID=183454
CARDLISTER_ORIGIN_POSTAL_CODE=54007

# Anthropic API key for vision identification. The anthropic SDK also reads
# ANTHROPIC_API_KEY directly; set this if you prefer to scope it to cardlister.
CARDLISTER_ANTHROPIC_API_KEY=
CARDLISTER_VISION_MODEL=claude-haiku-4-5

# Fernet key used to encrypt stored eBay OAuth refresh tokens at rest.
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CARDLISTER_TOKEN_ENCRYPTION_KEY=

# Where per-card photo folders live (each subfolder = one card).
CARDLISTER_CARDS_ROOT=
